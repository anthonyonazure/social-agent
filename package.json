{
  "name": "social-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*",
    "dashboard"
  ],
  "description": "Self-running AI content agent for short-form social video",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p services/core && tsc --noEmit -p services/api && tsc --noEmit -p services/workers && tsc --noEmit -p dashboard",
    "lint": "eslint .",
    "test": "bun test",
    "mutation": "stryker run",
    "check": "bun run typecheck && bun run lint",
    "dev:db": "docker compose up -d postgres",
    "dev:stack": "docker compose up -d",
    "dev:stack:down": "docker compose down",
    "dev:api": "pnpm --filter @social-agent/api dev",
    "dev:workers": "pnpm --filter @social-agent/workers dev",
    "dev:dashboard": "pnpm --filter @social-agent/dashboard dev",
    "dev:all": "pnpm -r --parallel --filter '@social-agent/*' dev",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @social-agent/core seed",
    "demo": "pnpm --filter @social-agent/workers demo"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "eslint": "^10.8.0",
    "playwright": "^1.59.1",
    "sharp": "^0.35.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.5",
    "form-data": ">=4.0.6",
    "postcss": ">=8.5.23",
    "qs": ">=6.15.2",
    "sharp": ">=0.35.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.5",
      "form-data": ">=4.0.6",
      "postcss": ">=8.5.23",
      "qs": ">=6.15.2",
      "sharp": ">=0.35.0"
    }
  }
}
